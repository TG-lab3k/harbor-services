# Server
PORT=8080
BASE_URL=http://localhost:8080
DB_BACKEND=memory

# Admin (fail-closed when ADMIN_EMAILS empty)
ADMIN_APP_ID=harborAdmin
ADMIN_EMAILS=["admin@example.com"]
ADMIN_PASSWORD=AdminPass123
SEED_ON_START=true

# JWT
JWT_ISSUER=harbor-services
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=2592000
# RSA_PRIVATE_KEY_PEM=
# RSA_PUBLIC_KEY_PEM=

# Crypto
ENCRYPTION_KEY=dev-encryption-key-change-me!!
BCRYPT_COST=12
APP_CACHE_TTL_SEC=300

# Firestore (when DB_BACKEND=firestore)
# GCP_PROJECT_ID=local-project
# FIRESTORE_EMULATOR_HOST=localhost:8081
